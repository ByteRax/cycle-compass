# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 安装非 root 账户与系统安全证书
RUN groupadd -g 10001 -r appgroup && \
    useradd -u 10001 -r -g appgroup -d /app -s /usr/sbin/nologin appuser && \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.27 /uv /bin/uv

# 复制工程配置与仅限 Python 相关代码
COPY pyproject.toml README.md ./
COPY packages/ ./packages/
COPY services/api/ ./services/api/
COPY references/strategy_original/index_rotation/data/ ./references/strategy_original/index_rotation/data/

# 创建虚拟环境、安装依赖，并统一交接目录属主权限
RUN uv venv /opt/venv && \
    . /opt/venv/bin/activate && \
    uv pip install -e . && \
    mkdir -p /app/data && \
    chown -R appuser:appgroup /app /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

USER appuser:appgroup

EXPOSE 8000

# 容器运行时健康检查
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://127.0.0.1:8000/api/v1/health || exit 1

CMD ["uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--loop", "uvloop", "--http", "httptools", "--timeout-keep-alive", "65"]
